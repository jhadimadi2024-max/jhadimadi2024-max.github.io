# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Kept strictly server-side; never exposed to client browser.
GEMINI_API_KEY=

# ELEVENLABS_API_KEY: Required for ElevenLabs Bengali Natural Neural Voice Text-to-Speech (TTS)
ELEVENLABS_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Supabase Configuration (Client-side, public-safe keys only)
# NOTE: Only publishable/anon keys are permitted. Never use service-role or secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Admin Authentication & Security (Server-side only)
# Admin credentials must be configured only in the hosting environment.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSCODE=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Platform Payment Gateways (Optional public merchant numbers)
VITE_MERCHANT_BKASH=
VITE_MERCHANT_NAGAD=

# Google Sheets Live Stock & Order Automation (Google Apps Script Web App URL)
VITE_GOOGLE_SHEETS_SCRIPT_URL=
GOOGLE_SHEETS_SCRIPT_URL=

# Jhadimadi AI Interactive Sales & Order Google Form URL
ORDER_GOOGLE_FORM_URL=https://forms.gle/jhadimadi-order
VITE_ORDER_GOOGLE_FORM_URL=https://forms.gle/jhadimadi-order


# Public contact configuration (do not hardcode production contacts in source)
PUBLIC_OFFICIAL_PHONE=
PUBLIC_OFFICIAL_EMAIL=

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=
ADMIN_EMERGENCY_KEY=
# Password recovery requires a trusted HTTPS webhook that delivers the code/token
# through a private channel (email/SMS provider). Never expose this value to the browser.
ADMIN_RESET_DELIVERY_WEBHOOK=
ORDER_NOTIFICATION_WEBHOOK=
CORS_ORIGINS=https://your-production-domain.example
TRUST_PROXY=false
